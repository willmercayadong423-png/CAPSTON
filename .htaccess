RewriteEngine On

# ── Force HTTPS in production ───────────────────────────────────
# Local dev hosts (localhost / Laragon *.test vhosts) are excluded so
# development keeps working without a TLS certificate. Any real host
# is 301-redirected to https — install a certificate (e.g. Let's
# Encrypt) BEFORE going live or browsers will warn on the redirect.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])$ [NC]
RewriteCond %{HTTP_HOST} !\.(test|local)$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Extensionless URLs → .php, but ONLY when that file exists ──────
# (previously this rewrote unconditionally, so /missing-page became
#  /missing-page.php and Apache answered with its PLAIN default 404)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ── Anything else that isn't a real file or directory → the branded
#    error page (folder-agnostic — works wherever the project lives).
#    error.php sends HTTP 404 unless Apache told it otherwise.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ error.php [L]

# Branded error pages for statuses the rewrite above can't catch
# (denied files/folders, script errors).
#
# ⚠ DEPLOYMENT STEP — these paths include the project folder name:
#   1. If the folder is renamed (recommended: deploy as `hehmhs`, no
#      space), update the paths below to match.
#   2. If deploying to the domain root, change them to /error.php.
ErrorDocument 403 /NEW%20UPCAP/error.php
ErrorDocument 404 /NEW%20UPCAP/error.php
ErrorDocument 500 /NEW%20UPCAP/error.php

Options -Indexes

# Stylesheets change often during development — always revalidate instead of
# letting phones/webviews serve stale CSS (the "missing cards" bug).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Block direct download of sensitive non-web files (config, schema, dumps,
# shell scripts, composer itself)
<FilesMatch "\.(sql|txt|json|lock|md|ini|log|env|sh|phar|csv|bak)$">
    Require all denied
</FilesMatch>
